# =====================================================
# 群资源站 —— nonebot2 QQ 机器人环境变量
# 复制为 .env.prod 后按实际情况修改
# =====================================================

# ----- 核心驱动 -----
# ~fastapi: 提供 HTTP 服务（供后端反向调用）
# ~httpx: HTTP 客户端（OneBot v11 反向 WS 连接需要）
# ~websockets: WebSocket 客户端
DRIVER=~fastapi+~httpx+~websockets
LOCALSTORE_USE_CWD=true
COMMAND_START=["/"]
COMMAND_SEP=["."]

# ----- HTTP 服务监听 -----
# 0.0.0.0 允许通过 Tailscale/局域网访问
HOST=0.0.0.0
PORT=8083
LOG_LEVEL=INFO

# ----- 后端 API 对接 -----
# backend 地址。本地用 127.0.0.1，跨网络用 Tailscale IP
BACKEND_API_BASE=http://127.0.0.1:8003
# 必须和 backend/.env 的 BOT_API_TOKEN 一致
BOT_API_TOKEN=change_me_shared_secret
# 站点前端地址（消息里的详情跳转链接）
# 本地开发用 5173，生产用 preview 端口 4173 或 nginx 端口
SITE_BASE_URL=http://127.0.0.1:5173

# ----- 插件：群成员同步 -----
# 要同步的 QQ 群号，多个用逗号分隔
SYNC_GROUPS=123456789
# 全量同步间隔（小时）
FULL_SYNC_INTERVAL_HOURS=6

# ----- 适配器（QQ 官方为主用，OneBot v11 为备用；可同时启用） -----

# 方案 A（主用）：QQ 官方开放平台机器人
# 在 https://q.qq.com 创建机器人后填写 AppID 和 AppSecret。
# 鉴权：官方已废弃旧 Bot Token，现统一用 Access Token —— 适配器自动用
#   AppID + AppSecret 换 access_token（POST getAppAccessToken，有效期 7200s 自动刷新），
#   所有 openapi / WS 鉴权均以 `Authorization: QQBot {access_token}` 完成。
#   因此下方 JSON 里 token 字段是适配器 schema 必填项但已不参与鉴权，留空 "" 即可；
#   secret（AppSecret）必须正确填写，否则连不上。
# 如需切换 Access Token 换取接口为新域名，可加（默认 bots.qq.com，官方文档现为 api.bot.qq.com）：
# QQ_AUTH_BASE=https://api.bot.qq.com/app/getAppAccessToken
# 群聊场景 intent 只需开 c2c_group_at_messages（群 @ 消息，含单聊）；
# 其余 guild_* intent 没有频道权限时保持 false，否则可能连不上。
# 注意：官方平台拿不到真实 QQ 号（只有 openid）、没有群成员列表 API，
# 成员白名单同步 / 头像校验 / 私聊发码由方案 B（OneBot）兜底。
# QQ_BOTS='[{"id":"你的AppID","token":"","secret":"你的AppSecret","intent":{"guilds":false,"guild_members":false,"guild_messages":false,"guild_message_reactions":false,"direct_message":false,"message_audit":false,"at_messages":false,"c2c_group_at_messages":true}}]'

# 方案 B（备用）：OneBot v11（NapCat/LLOneBot/Lagrange 等），二选一：
# B1. 正向 WebSocket（nonebot 连 NapCat 的 ws 服务，注意变量名是复数 URLS）：
# ONEBOT_WS_URLS=["ws://127.0.0.1:3001/onebot/v11/ws"]
# B2. 反向 WebSocket（NapCat 主动连本 bot）：NapCat 侧配置
#     ws://<本机>:8083/onebot/v11/ws，无需在 .env 配置
# OneBot access token（与 NapCat 侧一致；反向 WS 时校验 NapCat 上行的 token）
# ONEBOT_ACCESS_TOKEN=
