# =====================================================
# 群资源站 —— nonebot2 QQ 机器人环境变量
# 复制为 .env.prod 后按实际情况修改
# =====================================================

# ----- 核心驱动 -----
# ~fastapi: 提供 HTTP 服务（供后端反向调用）
# ~httpx: HTTP 客户端（OneBot v11 反向 WS 连接需要）
# ~websockets: WebSocket 客户端
DRIVER=~fastapi+~httpx+~websockets
LOCALSTORE_USE_CWD=true
COMMAND_START=["/", ""]
COMMAND_SEP=["."]

# ----- HTTP 服务监听 -----
# 0.0.0.0 允许通过 Tailscale/局域网访问
HOST=0.0.0.0
PORT=8083
LOG_LEVEL=INFO

# ----- 后端 API 对接 -----
# backend 地址。本地用 127.0.0.1，跨网络用 Tailscale IP
BACKEND_API_BASE=http://127.0.0.1:8003
# 必须和 backend/.env 的 BOT_API_TOKEN 一致
BOT_API_TOKEN=change_me_shared_secret
# 站点前端地址（消息里的详情跳转链接）
# 本地开发用 5173，生产用 preview 端口 4173 或 nginx 端口
SITE_BASE_URL=http://127.0.0.1:5173

# ----- 插件：群成员同步 -----
# 要同步的 QQ 群号，多个用逗号分隔
SYNC_GROUPS=123456789
# 全量同步间隔（小时）
FULL_SYNC_INTERVAL_HOURS=6

# ----- 适配器 -----
# OneBot v11（NapCat/LLOneBot 等）反向 WebSocket
ONEBOT_WS_URL=ws://127.0.0.1:3001/onebot/v11/ws
ONEBOT_ACCESS_TOKEN=
