# =====================================================
# 群资源站 —— nonebot2 QQ 机器人环境变量
# 复制为 .env.prod 后按实际情况修改
# =====================================================

# ----- 核心驱动 -----
# ~fastapi: 提供 HTTP 服务（供后端反向调用）
# ~httpx: HTTP 客户端（OneBot v11 反向 WS 连接需要）
# ~websockets: WebSocket 客户端
DRIVER=~fastapi+~httpx+~websockets
LOCALSTORE_USE_CWD=true
COMMAND_START=["/"]
COMMAND_SEP=["."]

# ----- HTTP 服务监听 -----
# 0.0.0.0 允许通过 Tailscale/局域网访问
HOST=0.0.0.0
PORT=8083
LOG_LEVEL=INFO

# ----- 后端 API 对接 -----
# backend 地址。本地用 127.0.0.1，跨网络用 Tailscale IP
BACKEND_API_BASE=http://127.0.0.1:8003
# 必须和 backend/.env 的 BOT_API_TOKEN 一致
BOT_API_TOKEN=change_me_shared_secret
# 站点前端地址（消息里的详情跳转链接）
# 本地开发用 5173，生产用 preview 端口 4173 或 nginx 端口
SITE_BASE_URL=http://127.0.0.1:5173

# ----- 插件：群成员同步 -----
# 要同步的 QQ 群号，多个用逗号分隔
SYNC_GROUPS=123456789
# 全量同步间隔（小时）
FULL_SYNC_INTERVAL_HOURS=6

# ----- 适配器（QQ 官方为主用，OneBot v11 为备用；可同时启用） -----

# 方案 A（主用）：QQ 官方开放平台机器人
# 在 https://q.qq.com 创建机器人后填写 AppID 和 AppSecret。
# 鉴权：官方已废弃旧 Bot Token，现统一用 Access Token —— 适配器自动用
#   AppID + AppSecret 换 access_token（POST getAppAccessToken，有效期 7200s 自动刷新），
#   所有 openapi / WS 鉴权均以 `Authorization: QQBot {access_token}` 完成。
#   因此下方 JSON 里 token 字段是适配器 schema 必填项但已不参与鉴权，留空 "" 即可；
#   secret（AppSecret）必须正确填写，否则连不上。
# 如需切换 Access Token 换取接口为新域名，可加（默认 bots.qq.com，官方文档现为 api.bot.qq.com）：
# QQ_AUTH_BASE=https://api.bot.qq.com/app/getAppAccessToken
# 群聊场景 intent 只需开 c2c_group_at_messages（群 @ 消息，含单聊）；
# 其余 guild_* intent 没有频道权限时保持 false，否则可能连不上。
# 注意：官方平台拿不到真实 QQ 号（只有 openid）、没有群成员列表 API，
# 成员白名单同步 / 头像校验 / 私聊发码由方案 B（OneBot）兜底。
# QQ_BOTS='[{"id":"你的AppID","token":"","secret":"你的AppSecret","intent":{"guilds":false,"guild_members":false,"guild_messages":false,"guild_message_reactions":false,"direct_message":false,"message_audit":false,"at_messages":false,"c2c_group_at_messages":true}}]'

# 方案 B（备用）：OneBot v11（NapCat/LLOneBot/Lagrange 等），二选一：
# B1. 正向 WebSocket（nonebot 连 NapCat 的 ws 服务，注意变量名是复数 URLS）：
# ONEBOT_WS_URLS=["ws://127.0.0.1:3001/onebot/v11/ws"]
# B2. 反向 WebSocket（NapCat 主动连本 bot）：NapCat 侧配置
#     ws://<本机>:8083/onebot/v11/ws，无需在 .env 配置
# OneBot access token（与 NapCat 侧一致；反向 WS 时校验 NapCat 上行的 token）
# ONEBOT_ACCESS_TOKEN=

# ----- 插件：AI 问答（/ai，OpenAI 兼容接口，支持本地模型） -----
# 远程 API：任何 OpenAI 兼容端点（OpenAI / DeepSeek / Kimi / GLM / 硅基流动等）
AI_API_BASE=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
# 系统提示词（可留空）
AI_SYSTEM_PROMPT=你是群资源站的助手机器人，回答简洁、友好，默认使用中文。
# 本地模型：Ollama / llama.cpp server / LM Studio / vLLM（OpenAI 兼容端点）
# Ollama 示例：ollama serve 后 ollama pull qwen2.5:7b
# 地址按部署形态选：
#   A 同机（本机/云单机）             http://127.0.0.1:11434/v1
#   B 模型在家、bot 上云（Tailscale） http://100.x.x.x:11434/v1（家里机器的 Tailscale IP）
# 安全：本地模型服务一般无鉴权，跨机时让它只绑 Tailscale 网卡（llama.cpp 用
#   --host 100.x.x.x；Ollama 用 OLLAMA_HOST=100.x.x.x:11434），不要裸绑 0.0.0.0
AI_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
AI_LOCAL_API_KEY=ollama
AI_LOCAL_MODEL=qwen2.5:7b
# 每个会话携带的最近对话轮数（1 轮 = 一问一答）
AI_MAX_HISTORY=6
# AI 请求超时（秒），本地大模型推理慢可调大
AI_TIMEOUT=120
# 联网搜索（AI 自主判断是否需要，文本协议工具调用 web:search）：SearXNG 实例地址
# 要求其 settings.yml 的 search.formats 包含 json；地址按部署形态选：
#   A 同机（本机/云单机）             http://127.0.0.1/searxng
#   B SearXNG 在家、bot 上云（Tailscale）http://100.x.x.x/searxng
# Apache 侧访问控制见 deploy/searxng-apache.conf（仅放行本机 + Tailscale 网段）
AI_SEARXNG_URL=http://127.0.0.1/searxng
# 每次搜索注入模型的结果条数
AI_SEARCH_RESULTS=5
# 单轮问答允许的最多工具调用次数（防止模型反复调用死循环）
AI_MAX_TOOL_STEPS=2

# ----- 内置多配置（可选）-----
# 默认配置由上方 AI_API_BASE / AI_API_KEY / AI_MODEL / AI_SYSTEM_PROMPT / AI_SEARXNG_URL 决定；
# 如需「在 QQ 内切换多套内置配置」，用 JSON 数组在此追加，启动时批量同步到后端，
# 所有用户可见、每人可独立点选（网页端 AI 配置弹窗 / 群内 /ai 切换 <名称>）。
# 每项字段：name（必填）、api_base（必填）、api_key、model、system_prompt、searxng_url。
# 例：
# AI_BUILTIN_CONFIGS='[{"name":"Kimi","api_base":"https://api.moonshot.cn/v1","api_key":"sk-xxx","model":"moonshot-v1-8k"},{"name":"GLM","api_base":"https://open.bigmodel.cn/api/paas/v4","api_key":"xxx","model":"glm-4-flash"}]'
# 注意：名称不要与「默认配置」重复；修改后需重启机器人（或管理员执行 /ai 配置 触发重新同步）。
