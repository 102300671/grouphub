# ---- 基础 ----
# API 基址：
#   开发/预览模式用 /api（由 Vite 代理转发）
#   纯静态部署（nginx）时改成完整后端地址
VITE_API_BASE=/api
VITE_SITE_NAME=群资源站

# ---- 代理目标（dev/preview 模式有效） ----
# 各服务的实际地址。本地开发用 127.0.0.1，
# Tailscale 跨网络时改成对方机器的 Tailscale IP（如 100.x.x.x）
VITE_BACKEND_TARGET=http://127.0.0.1:8003
VITE_ZFILE_TARGET=http://127.0.0.1:8081
VITE_ALIST_TARGET=http://127.0.0.1:5244

# ---- 打包/发布 ----
# 如果部署在子路径下（如 /app/），取消注释
# VITE_PUBLIC_PATH=/app/
