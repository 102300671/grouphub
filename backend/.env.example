# =====================================================
# 群图书馆 —— backend 环境变量示例
# 使用前请复制为 .env 并按实际情况修改
# =====================================================

# ----- 数据库 -----
# SQLite：单文件，零配置；后续可平滑换成 postgresql:///...
DATABASE_URL=sqlite:///./data/grouphub.db

# ----- 认证 -----
# 生产环境请替换为随机长字符串（例如：openssl rand -hex 32）
JWT_SECRET_KEY=please-change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
# token 有效期，单位：分钟
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ----- 机器人内部 API 鉴权（和 qqbot/.env.prod 的 BOT_API_TOKEN 保持一致） -----
BOT_API_TOKEN=change_me_shared_secret_between_backend_and_nonebot2
# nonebot2 侧 HTTP 服务地址（站点反向调 bot：发验证码 / 登录通知 / 注册触发拉头像，需 bot 用 ~fastapi driver）
QQBOT_API_BASE=http://127.0.0.1:8083

# ----- 站点 -----
SITE_NAME=群资源站
# CORS：前端静态站所在的 origin，多值用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 管理员 QQ 白名单（英文逗号分隔）；注册/登录时会自动赋 role=admin
ADMIN_QQS=12345,67890
# 作品详情页「张三、李四 等共 N 人」展示阈值；默认 3，可按需调
SHOW_RELATION_THRESHOLD=3
# 后台监听（与 qqbot/.env.prod 的 BACKEND_API_BASE、deploy/systemd 保持一致，默认 8003）
HOST=0.0.0.0
PORT=8003

# ----- 上传安全 -----
# 单个上传文件大小上限（MB），默认 32；同时按扩展名白名单校验类型
MAX_UPLOAD_MB=32
